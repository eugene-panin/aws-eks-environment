aws_region              = "eu-west-1"
expected_aws_account_id = "123456789012"
project_name            = "aws-eks-environment"
environment             = "prod"
vpc_cidr                = "10.50.0.0/16"
nat_gateway_mode        = "one_per_az"

cluster_version     = "1.35"
admin_principal_arn = "arn:aws:iam::123456789012:role/terraform-eks-admin"
node_instance_types = ["m7i.large"]
node_min_size       = 3
node_desired_size   = 3
node_max_size       = 9

database_instance_class            = "db.m7g.large"
database_multi_az                  = true
database_deletion_protection       = true
database_skip_final_snapshot       = false
database_final_snapshot_identifier = "replace-with-a-unique-final-snapshot-name"

# Replace this documentation CIDR with the trusted operator/CI egress address,
# or set an empty list to keep the endpoint private-only.
cluster_endpoint_public_access_cidrs = ["198.51.100.10/32"]

# The VPC CIDR is allowed automatically. Add routed VPN/peering CIDRs if needed.
cluster_private_access_cidrs = []

extra_tags = {
  Owner      = "platform-team"
  CostCentre = "replace-me"
}
