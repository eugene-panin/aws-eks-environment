aws_region              = "eu-west-1"
expected_aws_account_id = "123456789012"
project_name            = "aws-eks-environment"
environment             = "dev"
vpc_cidr                = "10.40.0.0/16"
nat_gateway_mode        = "single"

cluster_version     = "1.35"
admin_principal_arn = "arn:aws:iam::123456789012:role/terraform-eks-admin"
node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3

# Keep empty for a private-only API endpoint. To opt in, list only trusted CIDRs.
cluster_endpoint_public_access_cidrs = []

# The VPC CIDR is allowed automatically. Add routed VPN/peering CIDRs if needed.
cluster_private_access_cidrs = []

extra_tags = {
  Owner = "platform-team"
}
